{
  "builds": [
    { "src": "sensor-data.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/sensor-data", "dest": "/sensor-data.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
